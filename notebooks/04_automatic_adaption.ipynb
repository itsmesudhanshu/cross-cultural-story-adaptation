# %%
cultural_mapping = {

    # Names
    "Tom": "Rohan",
    "Jack": "Arjun",
    "Emily": "Ananya",

    # Locations
    "New York": "Delhi",
    "London": "Mumbai",

    # Festivals
    "Christmas": "Diwali",
    "Thanksgiving": "Pongal",

    # Roles
    "king": "Maharaja",
    "queen": "Maharani",
    "knight": "warrior",

    # Places
    "castle": "Raj Mahal"
}

# %%
def adapt_story(story):
    adapted_story = story

    for original, replacement in cultural_mapping.items():
        adapted_story = adapted_story.replace(original, replacement)
    return adapted_story    

# %%
story = """
Tom celebrated Christmas with his family in New York.
"""

print(adapt_story(story))

# %%
import spacy
nlp = spacy.load("en_core_web_sm")

story = """
Tom celebrated Christmas with his family in New York.
"""

doc = nlp(story)

print("Detected Entities:")

for ent in doc.ents:
    print(ent.text,"->", ent.label_)
print("\nAdapted Story")

print(adapt_story(story))


# %%
import pandas as pd
df=pd.read_csv("../data/stories.csv")
for story in df["story_text"]:
    print("Original")
    print(story)

    print("\nAdapted:")
    print(adapt_story(story))

    print("-"*50)

